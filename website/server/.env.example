PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=coastal_trails

# Optional: WhatsApp delivery of booking details (Twilio) — without these, a one-tap wa.me link is used instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp Cloud API (Meta) — preferred provider when both are set
# Phone Number ID: Meta app dashboard > WhatsApp > API Setup
# Access token: Business Settings > Users > System Users (permanent token)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BOOKING_TEMPLATE=coastal_booking
WHATSAPP_PAYMENT_TEMPLATE=coastal_payment
WHATSAPP_SIGNUP_TEMPLATE=coastal_welcome
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v22.0

# cPanel SMTP (booking confirmations)
SMTP_HOST=mail.coastaltrails.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=booking@coastaltrails.in
SMTP_PASSWORD=your_booking_mailbox_password
